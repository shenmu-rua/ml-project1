# ============================================================
# D 负责：Streamlit 前端镜像
# 构建：docker build -f Dockerfile.frontend -t ml-project1-frontend .
# 运行：docker run -p 8501:8501 ml-project1-frontend
# ============================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY schema.json ./schema.json

EXPOSE 8501

# API 地址：默认指向 docker-compose 网络内的 api 服务
ENV API_URL=http://api:8000/predict

CMD ["streamlit", "run", "app/frontend.py", "--server.port=8501", "--server.address=0.0.0.0"]