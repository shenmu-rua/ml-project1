# ============================================================
# D 负责：Streamlit 前端镜像
# 构建：docker build -f Dockerfile.frontend -t ml-project1-frontend .
# 运行：docker run -p 8501:8501 -e API_URL=http://host.docker.internal:8000 ml-project1-frontend
# ============================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 前端只用到这三个包；版本仍取自 requirements.txt，不另外维护一份。
COPY requirements.txt .
RUN grep -E '^(streamlit|requests|pandas)==' requirements.txt > frontend-requirements.txt \
    && test "$(wc -l < frontend-requirements.txt)" -eq 3 \
    && pip install -r frontend-requirements.txt

COPY schema.json ./schema.json
COPY .streamlit/config.toml ./.streamlit/config.toml
COPY app/frontend.py app/frontend.css app/frontend_choices.json app/frontend_zh.json ./app/

EXPOSE 8501

# 后端根地址：默认指向 docker-compose 网络内的 api 服务
ENV API_URL=http://api:8000

CMD ["streamlit", "run", "app/frontend.py", "--server.port=8501", "--server.address=0.0.0.0"]
