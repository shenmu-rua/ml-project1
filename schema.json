  "weather": {
    "maximum_distance_km": 40,
    "maximum_time_difference_minutes": 60,
    "require_observed_sources": true,
    "model_population": "core6_and_all_qc_checkable",
    "meteostat_observed_sources": [
      "isd_lite",
      "metar",
      "dwd_poi",
      "dwd_hourly"
    ],
    "core_fields": [
      "temp",
      "rhum",
      "prcp",
      "wdir",
      "wspd",
      "pres"
    ],
    "bounds": {
      "temp": {
        "min": -100,
        "max": 70,
        "unit": "degC",
        "dtype": "float64",
        "nullable": true
      },
      "rhum": {
        "min": 0,
        "max": 100,
        "unit": "percent",
        "dtype": "float64",
        "nullable": true
      },
      "prcp": {
        "min": 0,
